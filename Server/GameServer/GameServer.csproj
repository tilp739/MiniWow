<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameServer.Domain\GameServer.Domain.csproj" />
    <ProjectReference Include="..\GameServer.Persistence\GameServer.Persistence.csproj" />
    <ProjectReference Include="..\..\Shared\GameShared\GameShared.csproj" />
  </ItemGroup>

  <!-- Données de monde (Content/) copiées dans le dossier de sortie, lues au démarrage. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\Content\**\*.json"
          Link="Content\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Copie les données que le client a besoin de connaître (noms des créatures) dans Assets/Resources.
    Une seule source : Content/creatures.json. Le fichier copié n'est pas versionné.
  -->
  <PropertyGroup>
    <UnityResourcesContentDir>$(MSBuildThisFileDirectory)..\..\Client\UnityProject\Assets\Resources\Content\</UnityResourcesContentDir>
  </PropertyGroup>

  <Target Name="CopyContentToUnity" AfterTargets="Build" Condition="Exists('$(UnityResourcesContentDir)')">
    <ItemGroup>
      <ContentJsonForUnity Include="$(MSBuildThisFileDirectory)..\..\Content\**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ContentJsonForUnity)"
          DestinationFiles="@(ContentJsonForUnity->'$(UnityResourcesContentDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
